# Скопируйте в .env и заполните. Файл .env НЕ должен попадать в git.

# Обязателен при DJANGO_DEBUG=0. Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1

# Через запятую. Для сервера укажите реальное внутреннее имя/адрес.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Через запятую, с схемой, нужно при работе за прокси/по HTTPS, например https://helpes.example.local
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 — только если сайт отдаётся по HTTPS (включает secure-cookie)
DJANGO_SECURE_COOKIES=0

# База данных: sqlite (локальная разработка) или postgres (целевая)
DB_ENGINE=sqlite
DB_NAME=helpes
DB_USER=helpes
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Заявка без обновлений дольше N часов считается «давно не обновлявшейся»
HELPES_STALE_HOURS=48
# Защита открытой формы от спама: не более N заявок с одного IP за окно (секунды)
HELPES_RATE_LIMIT_COUNT=10
HELPES_RATE_LIMIT_WINDOW=3600

# 1 — только если перед приложением стоит ваш nginx (нужно для корректного антиспама по IP)
HELPES_BEHIND_PROXY=0
